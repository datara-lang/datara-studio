{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Datara Studio",
  "version": "0.5.1",
  "identifier": "lang.datara.studio",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "app", "dmg"],
    "resources": {
      "../src": "studio/src",
      "../ui/studio.html": "studio/ui/studio.html",
      "../ui/studio-core.html": "studio/ui/studio-core.html",
      "../assets/datara.ico": "studio/assets/datara.ico"
    },
    "fileAssociations": [
      {
        "ext": ["dtr"],
        "mimeType": "text/plain",
        "role": "Editor",
        "description": "Datara source file"
      }
    ],
    "category": "DeveloperTool",
    "shortDescription": "A lightweight IDE for Datara",
    "longDescription": "Datara Studio is a compiler-native, offline-first IDE for Datara.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
