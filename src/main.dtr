//! datara-studio :: entry point
//!
//! A loopback HTTP server that serves the IDE interface and exposes the
//! filesystem and the compiler to it. Start it from the `datara-studio`
//! directory so that `ui/studio.html` resolves:
//!
//!     forgen run src/main.dtr
//!
//! # The seams, after the 1.4.0 rewrite
//!
//! Everything in this project that exists *because of a forgen limitation* is
//! confined to one place per limitation and marked `SEAM-n`. `PORTING.md` is
//! the list, with the exact change to make once the compiler is fixed; grep for
//! `SEAM-` to find what to delete.
//!
//! Rewriting against 1.4.0 retired most of them. What each one looks like now,
//! measured rather than assumed:
//!
//!   SEAM-1  **GONE.** Every `List<Str>` read used to go through `st_at`,
//!           because indexing a local list returned a pointer in 1.3.0. Direct
//!           indexing is correct, and an out-of-range index returns `""` and
//!           continues (a literal that cannot fit is now a compile error,
//!           E0947). The helper is deleted.
//!   SEAM-2  **LIVE.** `unsafe(justification: "...")` still wraps every
//!           capability-bearing call; a bare `file_read` is E0940.
//!   SEAM-3  **GONE.** Exit status used to be inferred from the output text,
//!           because `system` returned the code and discarded the output while
//!           `exec` did the reverse. `system` returns the real code on 1.4.0, so
//!           the output is redirected to a file and read back: one process, both
//!           answers, no string matching. `/api/run` reports `exit`.
//!   SEAM-4  the AI companion imports its neural stack lazily - unchanged, and
//!           it is the companion's business, not the server's.
//!   SEAM-5  **SHRUNK.** `file_read` still returns zero bytes for content that
//!           is not UTF-8, but `file_read_bytes` now exists, so the IDE can tell
//!           an empty file from a binary one instead of showing a blank editor.
//!   SEAM-6  **LIVE.** A socket that connects and sends nothing still blocks the
//!           single-threaded accept loop forever: there is no timeout and no
//!           non-blocking mode in 1.4.0. Hence one self-contained `studio.html`
//!           with no subresources, four ports tried in order, and a watchdog.
//!   SEAM-7  **SHRUNK, and renamed.** The filesystem no longer goes through the
//!           shell at all - `dir_list`, `path_exists`, `file_exists`,
//!           `file_read` and `file_write` are native - so the console-codepage
//!           problem is now confined to `mkdir`, `move`, `delete`, `git` and
//!           content search, which have no builtin. But the native listing has
//!           an encoding defect of its own: `datara_runtime.c:2623` calls
//!           `FindFirstFileA`, so names come back as cp1251, not UTF-8.
//!           `st_from_ansi` converts them; when the runtime uses
//!           `FindFirstFileW` that function and its tables are deleted. See
//!           `explorer.dtr`.
//!   SEAM-8  **LIVE.** `forgen check` still colourises into a pipe and ignores
//!           `NO_COLOR` (both measured). A raw ESC inside a JSON string makes
//!           the document invalid, so `st_strip_ansi` stays.
//!
//! The request protocol (line-based bodies, no JSON parsing) is a design choice
//! rather than a workaround, and it is documented as such in `api.dtr`.

use http
use api
use layout
use explorer

/// The IDE interface: ONE self-contained file.
///
/// `ui/studio.html` is generated by `scripts/build-ui.mjs` and has React, htm,
/// the app and the wasm core inlined, with a data-URI favicon. That is not an
/// optimisation, it is the fix for a hard limitation: the runtime gives a socket
/// no timeout and no non-blocking mode, so a connection that connects and then
/// sends nothing blocks this single-threaded accept loop forever. Browsers open
/// exactly such connections, which made the interface load to a blank page.
/// With no subresources there is nothing for the browser to open an extra socket
/// for. See PORTING.md SEAM-6.
///
/// Two variants exist and neither is a separate server: `ui/studio.html` is the
/// studio with the companion, `ui/studio-core.html` is the same interface with
/// the two AI tabs taken out. `?core=1` on the root request serves the second
/// one, so the desktop shell, a browser tab and a shortcut can each choose
/// without a flag to the process. The fallback order is deliberate - if the core
/// file has not been built, the full studio is served rather than an error,
/// because a working IDE without the requested variant beats a broken page.
fn st_ui_page( core: Bool) -> Str {
    mut html = ""
    unsafe(justification: "serving the IDE interface to the local browser") {
        if core {
            if file_exists("ui/studio-core.html") {
                html = file_read("ui/studio-core.html")
            }
        } else {
            if file_exists("ui/studio.html") {
                html = file_read("ui/studio.html")
            }
        }
    }
    if byte_len(html) == 0 && core {
        return st_ui_page(false)
    }
    if byte_len(html) == 0 {
        return "<html><body style=\"font-family:sans-serif;padding:40px;background:#101013;color:#e6e6ea\">"
             + "<h2>ui/studio.html not built</h2>"
             + "<p>Build it, then reload:</p>"
             + "<pre>node scripts/build-ui.mjs</pre></body></html>"
    }
    return html
}

fn st_json( fd: Int, body: Str) {
    let sent = st_respond(fd, 200, "application/json; charset=utf-8", body)
    return
}

fn st_handle( fd: Int, tc: Str) {
    mut raw = ""
    unsafe(justification: "reading the incoming HTTP request from the IDE UI") {
        raw = st_read_request(fd)
    }
    if byte_len(raw) == 0 {
        return
    }

    let line = st_request_line(raw)
    let path = st_path_of(line)
    let body = st_body_of(raw)

    if path == "/" || path == "/index.html" {
        // `st_path_of` deliberately cuts the query off, so the variant flag has
        // to be read from the raw request line. Any `core=1` substring is
        // accepted rather than an exact match: a browser may append anything
        // (a cache buster, a fragment the shell adds), and the only thing that
        // matters here is whether the root request asked for the core build.
        let wants_core = str_index_of(line, "core=1") >= 0
        let sent = st_respond(fd, 200, "text/html; charset=utf-8", st_ui_page(wants_core))
        return
    }
    if path == "/api/health" {
        st_json(fd, st_health(tc))
        return
    }
    if path == "/api/tree" {
        st_json(fd, st_tree(str_trim(body)))
        return
    }
    if path == "/api/read" {
        st_json(fd, st_read(str_trim(body)))
        return
    }
    if path == "/api/write" {
        st_json(fd, st_write(str_trim(st_first_line(body)), st_rest_after_first_line(body)))
        return
    }
    if path == "/api/run" {
        st_json(fd, st_run(str_trim(body)))
        return
    }
    if path == "/api/action" {
        st_json(fd, st_run_named(str_trim(st_first_line(body)),
                                 str_trim(st_rest_after_first_line(body))))
        return
    }
    if path == "/api/mkdir" {
        st_json(fd, st_mkdir(str_trim(body)))
        return
    }
    // create a file, making its folder first when the folder is missing
    if path == "/api/new" {
        st_json(fd, st_new_file(str_trim(st_first_line(body)),
                                st_rest_after_first_line(body)))
        return
    }
    if path == "/api/list" {
        st_json(fd, st_list_dir(str_trim(body)))
        return
    }
    // compiler diagnostics for one file, or for the project that governs it -
    // the body is `path\nworkspace root`, and the root bounds the search for the
    // project file so a check can never wander above the workspace
    if path == "/api/check" {
        st_json(fd, st_check(str_trim(st_first_line(body)),
                             str_trim(st_rest_after_first_line(body))))
        return
    }
    if path == "/api/move" {
        st_json(fd, st_move(str_trim(st_first_line(body)),
                            str_trim(st_rest_after_first_line(body))))
        return
    }
    if path == "/api/find" {
        // Three lines: root, query, and whether the query must match a whole
        // name. The third is optional so that an older client - or a curl - that
        // sends two lines still gets a substring search rather than an error.
        st_json(fd, st_find(str_trim(st_first_line(body)),
                            str_trim(st_first_line(st_rest_after_first_line(body))),
                            str_trim(st_rest_after_first_line(
                                st_rest_after_first_line(body))) == "1"))
        return
    }
    // branch, changed files and recent commits for the workspace - one git
    // process launch, not three, because the UI polls this every 12 s
    if path == "/api/git" {
        st_json(fd, st_git(str_trim(body)))
        return
    }
    // the body is `kind\npath`, where `kind` is what the interface believes it
    // is deleting and the filesystem is asked instead
    if path == "/api/delete" {
        st_json(fd, st_delete(str_trim(st_first_line(body)),
                              str_trim(st_rest_after_first_line(body))))
        return
    }
    if path == "/api/ai/start" {
        st_json(fd, st_ai_start(str_trim(body)))
        return
    }
    if path == "/api/layout" {
        st_json(fd, st_layout_report(str_trim(body)))
        return
    }
    // interface assets: /ui/... maps to ui/..., /vendor/... to ui/vendor/...
    if st_has_prefix(path, "/ui/") {
        let rel = "ui/" + str_substring(path, 4, byte_len(path) - 4)
        let asset = st_read_asset(rel)
        if byte_len(asset) == 0 {
            let miss = st_respond(fd, 404, "text/plain; charset=utf-8", "missing asset: " + rel)
            return
        }
        let sent = st_respond(fd, 200, st_content_type(rel), asset)
        return
    }
    if st_has_prefix(path, "/vendor/") {
        let rel = "ui/vendor/" + str_substring(path, 8, byte_len(path) - 8)
        let asset = st_read_asset(rel)
        if byte_len(asset) == 0 {
            let miss = st_respond(fd, 404, "text/plain; charset=utf-8", "missing asset: " + rel)
            return
        }
        let sent = st_respond(fd, 200, st_content_type(rel), asset)
        return
    }
    let sent = st_respond(fd, 404, "application/json; charset=utf-8",
                          "{\"ok\":false,\"error\":\"no such endpoint\"}")
    return
}

/// The port to listen on.
///
/// `DATARA_STUDIO_PORT` lets a second instance run alongside the first. That is
/// not a nicety: the runtime gives a socket no timeout and no non-blocking
/// mode, so one connection that connects and sends nothing blocks this
/// single-threaded accept loop permanently. A browser opens exactly such
/// connections. The launcher therefore runs two servers on two ports and the
/// interface uses whichever answers - see PORTING.md SEAM-6.
fn st_port() -> Int {
    let v = str_trim(env_get("DATARA_STUDIO_PORT"))
    if byte_len(v) == 0 {
        return 7878
    }
    let n = str_to_int(v)
    if n < 1024 || n > 65535 {
        return 7878
    }
    return n
}

fn main() {
    let port = st_port()
    mut listener = -1
    mut bound = false
    unsafe(justification: "Datara Studio listens on loopback to serve its own interface") {
        listener = socket_create(1)
        if listener >= 0 {
            let b = socket_bind(listener, "127.0.0.1", port)
            let l = socket_listen(listener, 64)
            if b >= 0 && l >= 0 {
                bound = true
            }
        }
    }

    if !bound {
        println("datara-studio: could not bind 127.0.0.1:" + int_to_str(port))
        println("  another instance may already be running, or the port is taken")
        return
    }

    println("")
    println("  Datara Studio 0.3.0")
    println("  interface  http://127.0.0.1:" + int_to_str(port))
    println("  ai         http://127.0.0.1:7890  (optional, start it from D:\\ryan)")
    println("  stop       Ctrl+C")
    println("")

    // Read the toolchain line once, here, not inside the health handler.
    // `st_toolchain` spawns `forgen --version`, which costs ~225-270 ms, and the
    // launcher's watchdog asks for /api/health every four seconds on up to four
    // ports - so per-request reading made health the slowest endpoint in the
    // server (245-305 ms, against 2.1 ms for the whole interface).
    let tc = st_toolchain()

    mut served = 0
    while bound {
        mut client = -1
        unsafe(justification: "accepting IDE UI connections") {
            client = socket_accept(listener)
        }
        if client >= 0 {
            st_handle(client, tc)
            unsafe(justification: "closing the finished connection") {
                socket_close(client)
            }
            served = served + 1
        }
    }
}
