//! ryan-events :: module root
//!
//! Typed event bus with scoped subscriptions, priorities, cancellation,
//! backpressure via a bounded log, storm protection for high-frequency kinds,
//! correlation ids and a deterministic test mode.
//!
//!   kinds - canonical event vocabulary and subsystem routing
//!   bus   - subscriptions, publish, ordered delivery plan, storm protection

use events.kinds
use events.bus
use events.plan

/// Self-test used by the headless CLI and the conformance runner.
pub fn event_bus_selftest() -> Outcome<Str> {
    let clk = clock_logical()
    mut b = bus_new(clk)
    b = bus_deterministic(b, clk)

    let s1 = bus_subscribe(b, ev_document_changed(), 10, scope_document(), 1)
    b = subscribe_bus(s1)
    let s2 = bus_subscribe(b, "", 5, scope_kernel(), 0)
    b = subscribe_bus(s2)
    let s3 = bus_subscribe(b, ev_document_changed(), 10, scope_document(), 2)
    b = subscribe_bus(s3)

    let p = bus_publish(b, ev_document_changed(), "test", [field_int("revision", 2)])
    b = publish_bus(p)

    let pumped = bus_pump(b)
    let ds = pump_deliveries(pumped)
    if ds.len() != 3 {
        return outcome_fail("", fmt"expected 3 deliveries, got {ds.len()}")
    }
    // priority 10 before priority 5; equal priority ordered by id ascending
    if delivery_subscription_id(ds[0]) != 1 {
        return outcome_fail("", "priority ordering violated")
    }
    if delivery_subscription_id(ds[1]) != 3 {
        return outcome_fail("", "id tiebreak violated")
    }
    if delivery_subscription_id(ds[2]) != 2 {
        return outcome_fail("", "wildcard should be delivered last")
    }

    // unsubscribe is safe and stops delivery
    b = pump_bus(pumped)
    b = bus_unsubscribe(b, 1)
    let p2 = bus_publish(b, ev_document_changed(), "test", [])
    b = publish_bus(p2)
    let pumped2 = bus_pump(b)
    if pump_deliveries(pumped2).len() != 2 {
        return outcome_fail("", "unsubscribe did not take effect")
    }

    if !event_kind_is_known(ev_breakpoint_hit()) {
        return outcome_fail("", "breakpoint kind not in catalog")
    }
    if event_kind_subsystem(ev_document_changed()) != "workspace" {
        return outcome_fail("", "subsystem routing wrong")
    }
    return outcome_ok("event bus self-test passed")
}
