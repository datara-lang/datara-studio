//! GENERATED by scripts/gen_bool_probe.py - do not edit by hand.
//!
//! Probe: a struct containing Bool fields, pushed into a List and read back,
//! can return wrong values. One struct per candidate layout, so the trigger is
//! isolated by observation rather than guessed at.
//!
//! Every variant is constructed with deferred_mode=false and cancelled=false.
//! Any line printing `true` is a miscompile.

fn b2s(v: Bool) -> Str {
    mut res = "false"
    if v {
        res = "true"
    }
    return res
}

pub struct V0_exact_subscription {
    id: Int
    kind: Str
    subsystem: Str
    priority: Int
    scope: Str
    scope_id: Int
    deferred_mode: Bool
    cancelled: Bool
    delivery_count: Int
    muted: List<Str>
}

pub fn V0_exact_subscription_new(id: Int, kind: Str, scope_id: Int) -> V0_exact_subscription {
    return V0_exact_subscription {
        id: id,
        kind: kind,
        subsystem: "",
        priority: 10,
        scope: "document",
        scope_id: scope_id,
        deferred_mode: false,
        cancelled: false,
        delivery_count: 0,
        muted: []
    }
}

fn V0_exact_subscription_scope_id(view x: V0_exact_subscription) -> Int => x.scope_id
fn V0_exact_subscription_deferred_mode(view x: V0_exact_subscription) -> Bool => x.deferred_mode
fn V0_exact_subscription_cancelled(view x: V0_exact_subscription) -> Bool => x.cancelled

