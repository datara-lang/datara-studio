//! GENERATED: every field name is prefixed per struct.

pub struct SA {
    a_id: Int
    a_kind: Str
    a_subsystem: Str
    a_priority: Int
    a_scope: Str
    a_scope_id: Int
    a_deferred_mode: Bool
    a_cancelled: Bool
    a_delivery_count: Int
    a_muted: List<Str>
}

pub fn sA_new(id: Int, kind: Str, scope_id: Int) -> SA {
    return SA {
        a_id: id,
        a_kind: kind,
        a_subsystem: "",
        a_priority: 10,
        a_scope: "document",
        a_scope_id: scope_id,
        a_deferred_mode: false,
        a_cancelled: false,
        a_delivery_count: 0,
        a_muted: []
    }
}

fn sA_get_scope_id(view x: SA) -> Int => x.a_scope_id
fn sA_get_a_deferred_mode(view x: SA) -> Bool => x.a_deferred_mode
fn sA_get_a_cancelled(view x: SA) -> Bool => x.a_cancelled

pub struct SB {
    b_id: Int
    b_kind: Str
    b_scope_id: Int
    b_deferred_mode: Bool
    b_cancelled: Bool
}

pub fn sB_new(id: Int, kind: Str, scope_id: Int) -> SB {
    return SB {
        b_id: id,
        b_kind: kind,
        b_scope_id: scope_id,
        b_deferred_mode: false,
        b_cancelled: false
    }
